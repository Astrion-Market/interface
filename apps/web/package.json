{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "build:vercel": "react-router build && node scripts/vercel-output.mjs",
    "preview": "react-router-serve ./build/server/index.js",
    "start": "react-router-serve ./build/server/index.js",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:faucet": "node scripts/test-usdc-faucet.mjs",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "^2.7.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@stellar/stellar-sdk": "^17.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@workspace/ui": "workspace:*",
    "isbot": "^5.2.2",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "vite": "^8.3.3"
  }
}
